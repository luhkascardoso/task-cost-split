{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run check)",
      "Bash(npm run test:coverage)",
      "Bash(npm run test:coverage *)",
      "Bash(npx expo install *)",
      "Bash(npx expo lint)",
      "Bash(npx expo-doctor)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Edit(/.github/workflows/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Bash(npx eas-cli* submit *)",
      "Bash(npx eas-cli* update *)",
      "Bash(git push *)",
      "Edit(/.githooks/**)"
    ],
    "deny": [
      "Edit(/ios/**)",
      "Edit(/android/**)",
      "Read(.env*.local)",
      "Edit(.env*.local)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config core.hooksPath*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-edited-file.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-before-stop.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
