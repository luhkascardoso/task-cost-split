#!/usr/bin/env bash
# Roda os mesmos gates do CI antes de qualquer push (seu ou de um agente).
# Se algo falhar, o push é cancelado. Ativado por `npm install` (script "prepare").
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Push que só apaga branch/tag remota não precisa de checagem.
zero="0000000000000000000000000000000000000000"
refs=0; deletes=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  refs=$((refs + 1))
  [ "$local_sha" = "$zero" ] && deletes=$((deletes + 1))
done
[ "$refs" -gt 0 ] && [ "$refs" -eq "$deletes" ] && exit 0

step() { printf '\n\033[1m▶ %s\033[0m\n' "$1"; }
fail() { printf '\n\033[31m✖ %s falhou. Push cancelado.\033[0m\n' "$1" >&2; exit 1; }

step "Typecheck"; npm run --silent typecheck || fail "Typecheck"
step "Lint";      npm run --silent lint      || fail "Lint"
step "Testes + cobertura"; npm run --silent test:coverage -- --silent || fail "Testes"

printf '\n\033[32m✔ Typecheck, lint e testes ok. Seguindo com o push.\033[0m\n'
